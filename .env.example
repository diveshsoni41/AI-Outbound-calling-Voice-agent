# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# --- LiveKit (https://cloud.livekit.io -> Settings -> API keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
AGENT_NAME=healthcare-outbound-agent

# --- Telephony ---
# Outbound SIP trunk ID from `lk sip outbound list` (starts with ST_).
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
# Comma-separated E.164 numbers you are authorized to call. Calls to any other
# number are refused before anything is dialed.
AUTHORIZED_TEST_NUMBERS=+15555550123
RING_TIMEOUT_SECONDS=30
MAX_CALL_DURATION_SECONDS=600

# --- OpenAI (speech-to-text, LLM, text-to-speech, post-call analysis) ---
OPENAI_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4.1-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
ANALYSIS_MODEL=gpt-4.1-mini
POST_CALL_LLM_ENABLED=true

# --- Opik (https://www.comet.com/opik -> API key) ---
OPIK_ENABLED=true
OPIK_API_KEY=your-opik-api-key
OPIK_WORKSPACE=your-workspace-name
OPIK_PROJECT_NAME=healthcare-outbound-calls
# Only for self-hosted Opik, e.g. http://localhost:5173/api
# OPIK_URL_OVERRIDE=

# --- Conversation ---
# Leave unset unless you have an accurate organization name to announce.
# ORGANIZATION_NAME=
CLINIC_TIMEZONE=America/New_York
EMERGENCY_NUMBER=911

# --- Local storage ---
ARTIFACTS_DIR=artifacts
APPOINTMENTS_DB_PATH=artifacts/appointments.sqlite3
RECORD_AUDIO=true
# Demo-only failure injection for the simulated scheduler: none | no_slots | booking_failure
SCHEDULER_SIMULATION=none
